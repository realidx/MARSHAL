  KuhnPoker-second:
    env_type: kuhn_poker
    max_actions_per_traj: 8
    grid_vocab: false
    env_config:
      built_in_opponent: cfr
      opponent_player: 0
      render_mode: text
  LeducPoker-first:
    env_type: leduc_poker
    max_actions_per_traj: 8
    grid_vocab: false
    env_config:
      built_in_opponent: ne
      render_mode: text
  LeducPoker-second:
    env_type: leduc_poker
    max_actions_per_traj: 8
    grid_vocab: false
    env_config:
      built_in_opponent: ne
