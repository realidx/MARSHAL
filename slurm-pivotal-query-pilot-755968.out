      seed_offset: -30
      response_token_limit: 128
train_env_manager:
  format_penalty: 0.0
  max_env_num_per_worker: 80
  env_groups: 40
  group_size: 8
  tags:
  - PivotalQuery-Known
  - PivotalQuery-Necessary
  - PivotalQuery-Costly
  - PivotalQuery-Irrelevant
  n_groups:
  - 10
  - 10
  - 10
  - 10
  minimax_length_penalty_beta: 0.0
  minimax_length_soft_budget: 400
  minimax_length_hard_budget: 600
  max_invalid_retries_per_decision: 0
  enable_length_penalty: false
  group_seed_base: 800000
val_env_manager:
  max_env_num_per_worker: 32
  env_groups: 32
  group_size: 1
  tags:
  - TicTacToe-first-100
  - TicTacToe-second-100
  - TicTacToe-first-1000
  - TicTacToe-second-1000
  n_groups:
  - 8
  - 8
  - 8
  - 8
  format_penalty: 0.0
  enable_length_penalty: false
gamma: 1.0
game_step_discount: 0.9
loss_agg_mode: seq-mean-token-mean
markovian_turn_context: true
use_reason_answer_format: false
add_token_level_kl: false
eval_at_end: true
dump_debug_batches: false

