    grid_vocab: false
    env_config:
      built_in_opponent: mcts
      opponent_player: 0
      max_simulations: 1000
      render_mode: text
  KuhnPoker-first:
    env_type: kuhn_poker
    max_actions_per_traj: 8
    grid_vocab: false
