num_gpus_per_node: 1
max_steps: 1
save_steps: 1000000
logging_steps: 1
eval_steps: 10
resume_from_checkpoint: false
rollout_batch_size: 60
val_batch_size: 32
sequence_length: 4096
dual_clip_loss: true
ppo_epochs: 1
adv_estimator: reinforce
init_kl_coef: 0.0
use_kl_loss: true
kl_loss_coef: 0.2
whiten_advantages: false
entropy_loss_coef: 0
pretrain: /home/e/e1300530/models/Qwen3-4B-Instruct-2507
actor_train:
  model_args:
    flash_attn: fa2
    disable_gradient_checkpointing: false
    dtype: bf16
    model_type: null
  training_args:
    lr_scheduler_type: cosine_with_min_lr
    learning_rate: 1.0e-06
    weight_decay: 0.05
    adam_beta1: 0.9
    adam_beta2: 0.95
    per_device_train_batch_size: 1
    gradient_accumulation_steps: 4
    warmup_steps: 10
  data_args:
    template: qwen3
  strategy_args:
    strategy_name: megatron_train
    strategy_config:
      sequence_parallel: true
      tensor_model_parallel_size: 2
      pipeline_model_parallel_size: 1
      expert_model_parallel_size: 1
      use_distributed_optimizer: true
      recompute_granularity: full
      accumulate_allreduce_grads_in_fp32: true
      check_for_nan_in_loss_and_grad: false
  device_mapping: list(range(0,1))
  infer_batch_size: 1
actor_infer:
  model_args:
    flash_attn: fa2
    disable_gradient_checkpointing: true
    dtype: bf16
  generating_args:
    max_new_tokens: 128
    top_p: 0.8
    top_k: 20
    num_beams: 1
    temperature: 0.7
    num_return_sequences: 1
    stop:
    - </answer>
    include_stop_str_in_output: true
  data_args:
    template: qwen3
  strategy_args:
    strategy_name: vllm
    strategy_config:
      gpu_memory_utilization: 0.8
      block_size: 16
      load_format: auto
      max_model_len: 4096
      tensor_parallel_size: 1
  device_mapping: list(range(0,1))
reference:
  model_args:
    flash_attn: fa2
    disable_gradient_checkpointing: true
    dtype: bf16
    model_type: null
  data_args:
    template: qwen3
  strategy_args:
    strategy_name: hf_infer
    strategy_config: null
  device_mapping: list(range(0,1))
  infer_batch_size: 1
