num_gpus_per_node: 1
max_steps: 1
save_steps: 20
logging_steps: 1
eval_steps: 5
resume_from_checkpoint: false
rollout_batch_size: 128
val_batch_size: 1500
sequence_length: 4096
dual_clip_loss: true
ppo_epochs: 1
adv_estimator: reinforce
init_kl_coef: 0.0
use_kl_loss: true
kl_loss_coef: 0.2
whiten_advantages: false
entropy_loss_coef: 0
