train_env_manager:
  format_penalty: 0.0
  max_env_num_per_worker: 160
  env_groups: 30
  group_size: 32
  tags:
  - Geography-Rollout-Distance-1
  - Geography-Rollout-Distance-3
  - Geography-Rollout-Distance-5
  n_groups:
  - 10
  - 10
  - 10
  minimax_length_penalty_beta: 0.0
  minimax_length_soft_budget: 1000
  minimax_length_hard_budget: 1200
  max_invalid_retries_per_decision: 0
  enable_length_penalty: false
  group_seed_base: 700000
val_env_manager:
  max_env_num_per_worker: 32
  env_groups: 32
  group_size: 1
  tags:
  - TicTacToe-first-100
  - TicTacToe-second-100
  - TicTacToe-first-1000
  - TicTacToe-second-1000
  n_groups:
  - 8
  - 8
  - 8
  - 8
  format_penalty: 0.0
  enable_length_penalty: false
gamma: 1.0
game_step_discount: 1.0
loss_agg_mode: seq-mean-token-mean
markovian_turn_context: true
use_reason_answer_format: true
add_token_level_kl: false
eval_at_end: true
dump_debug_batches: false

